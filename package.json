{
  "name": "@pushplatform/web-sdk",
  "version": "0.1.0",
  "description": "Web SDK PushPilot: Web Push, service worker и управление подписками",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./service-worker": {
      "import": "./dist/service-worker.js",
      "require": "./dist/service-worker.cjs"
    },
    "./script": "./dist/sdk.global.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "example/index.html",
    "example/npm.html",
    "example/main.js",
    "example/service-worker.js",
    "example/README.md",
    "scripts/copy-assets.mjs",
    "docs/API.md",
    "docs/WEB_BROWSER_AUTH_TASK.md",
    "docs/WEB_SDK_RELEASE.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && npm run build:sw && node scripts/finalize-build.mjs",
    "build:sw": "vite build --config vite.sw.config.ts",
    "dev": "vite build --watch",
    "dev:example": "npm run prepare:example && vite --config example/vite.config.ts",
    "test": "vitest run",
    "pack:check": "node scripts/verify-package.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prepack": "npm run build",
    "prepare:example": "npm run build && node scripts/copy-assets.mjs",
    "test:browser": "npm run pack:check && playwright test",
    "release:check": "npm run typecheck && npm test && npm run test:browser"
  },
  "keywords": [
    "push",
    "notifications",
    "web-push",
    "push-api",
    "service-worker",
    "vapid",
    "pushplatform"
  ],
  "author": "PushPlatform",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pushplatform/pushpilot-sdk-web.git",
    "directory": "."
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.4",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "jsdom": "^29.1.1",
    "prettier": "^3.1.0",
    "terser": "^5.51.2",
    "typescript": "^5.3.0",
    "vite": "^7.3.7",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
