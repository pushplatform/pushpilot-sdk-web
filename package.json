{
  "name": "@pushplatform/web-sdk",
  "version": "0.1.0",
  "description": "Web SDK for PushPlatform - Web Push notifications integration",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./service-worker": {
      "import": "./dist/service-worker.js",
      "require": "./dist/service-worker.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build && npm run build:sw",
    "build:sw": "vite build --config vite.sw.config.ts",
    "dev": "vite build --watch",
    "dev:example": "vite --config example/vite.config.ts",
    "test": "vitest run",
    "pack:check": "npm pack --dry-run --json",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "keywords": [
    "push",
    "notifications",
    "web-push",
    "push-api",
    "service-worker",
    "vapid",
    "pushplatform"
  ],
  "author": "PushPlatform",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pushplatform/pushpilot-sdk-web.git",
    "directory": "."
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^8.54.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.1.0",
    "terser": "^5.51.2",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.6.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
